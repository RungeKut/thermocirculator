*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

*Log.txt
# --- Офлайн-комплект: крупные инсталляторы не под git ---
# Комплект переносится копированием каталога tools/ целиком.
# Состав и контрольные суммы фиксируются в tools/manifest.json.
# Крупные дистрибутивы — вне git; скрипты автоустановки рядом с ними нужны.
tools/installers/**/*.exe
tools/installers/**/*.EXE
tools/installers/**/*.zip
tools/installers/**/*.msi
# Arm Compiler 5 — проприетарное ПО Arm, публиковать нельзя.
tools/installers/**/*.7z
tools/installers/**/*.app/
tools/installers/**/*.linux

# --- Артефакты сборки Keil ---
Objects/
Listings/
*.axf
*.build_log.htm
*.dep
*.crf
*.lnp
*.iex
*.sct.Bak
*.uvguix.*
DebugConfig/
RTE/_*/

# .uvoptx НЕ игнорируется намеренно: в нём настройки отладчика и
# алгоритма прошивки, влияющие на воспроизводимость.

# --- Прочее ---
*.bak

# Листинги и карты вызовов, создаваемые линкером
*.lst
**/MDK-ARM/*/*.htm

# Резервные копии, создаваемые механизмом RTE при разрешении компонентов
*.base@*

# --- Altium: генерируемое и резервные копии ---
hardware/**/Project Outputs for *
hardware/**/Project Logs for *
hardware/**/History/
hardware/**/__Previews/
hardware/**/BackUp*.7z
hardware/**/Altium.7z
# 3D-модели — производное от плат, в репозиторий не берутся
hardware/**/*.step
hardware/**/*.stp
hardware/**/*.SLDPRT
hardware/**/*.SLDASM
hardware/**/*.SLDDRW
